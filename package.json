{
  "name": "tracepulse",
  "version": "1.0.0",
  "description": "Distributed Tracing, OpenTelemetry Spans & Microservice Performance Observability Engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "build:pages": "npm run build:pages --workspace=client"
  },
  "keywords": [
    "opentelemetry",
    "distributed-tracing",
    "w3c-tracecontext",
    "apm",
    "trace-viewer",
    "observability",
    "react",
    "sqlite"
  ],
  "author": "Taaniel Vananurm",
  "license": "MIT",
  "homepage": "https://taan1el.github.io/tracepulse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/tracepulse.git"
  },
  "bugs": {
    "url": "https://github.com/Taan1el/tracepulse/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
